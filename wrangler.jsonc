{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aarvi-secure-messenger",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aarvi-db",
      "database_id": "894c63d8-e47c-4cf8-8d41-a45240741e74",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "JWT_SECRET": "aarvi-secure-e2ee-jwt-secret-key-2026",
    "ENVIRONMENT": "production"
  }
}
